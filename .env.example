# Firebase web app config (Firebase console > Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server only). Firebase console > Project settings > Service accounts >
# Generate new private key, then paste the whole JSON file on one line.
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...or instead set these three:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase - only needed by scripts/migrate-supabase-to-firebase.mjs; remove after migrating
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (use rzp_test_ keys outside production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend email
RESEND_API_KEY=
EMAIL_FROM="Triplovia <noreply@triplovia.com>"

# Twilio WhatsApp booking confirmations (guest + hotel), see docs/WHATSAPP_TEMPLATES.md.
# Leave empty to skip WhatsApp. Use an API key (SK...) + secret, or the account auth token.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
# WhatsApp sender in E.164, e.g. +14155238886 for the Twilio sandbox
TWILIO_WHATSAPP_FROM=
# Content SIDs (HX...) of the approved templates
TWILIO_WA_GUEST_BOOKING_SID=
TWILIO_WA_HOTEL_BOOKING_SID=

# bunny.net (lib/bunny/config.ts). Images: leave the storage settings empty to keep using
# Firebase Storage. Storage zone > FTP & API Access > Password (not the read-only one);
# region code empty for Frankfurt, else ny, la, sg, syd, uk, se, br, jh.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_REGION=
# Pull zone connected to the storage zone, e.g. https://triplovia.b-cdn.net (or a custom CDN domain)
BUNNY_CDN_URL=

# Shared secret for /api/cron/cancel-stale-bookings (sent by the Netlify scheduled function)
CRON_SECRET=

# Public URLs (http://localhost:3000 in development); used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
